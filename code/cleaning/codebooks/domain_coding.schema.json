{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain coding batch",
  "description": "One batch of coded domains; field definitions are in domain_coding.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "extractor_model", "extracted_on", "items"],
  "properties": {
    "batch_id": {"type": "string"},
    "extractor_model": {"type": "string", "minLength": 1},
    "extracted_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "tri_state": {"enum": ["yes", "no", "unclear"]},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "domain",
        "category",
        "stance_on_abortion_access",
        "cpc_affiliated",
        "provides_abortions",
        "site_loaded",
        "evidence_urls",
        "rationale",
        "confidence"
      ],
      "properties": {
        "item_id": {"type": "string"},
        "domain": {"type": "string"},
        "category": {
          "enum": [
            "abortion_provider",
            "telehealth_abortion_provider",
            "hospital_or_health_system",
            "other_medical_practice",
            "crisis_pregnancy_center",
            "abortion_directory",
            "abortion_fund_or_support",
            "advocacy_or_research",
            "government",
            "news_media",
            "reference",
            "business_listing",
            "social_media_or_forum",
            "other",
            "unclear"
          ]
        },
        "stance_on_abortion_access": {
          "enum": ["supports_access", "opposes_access", "neutral", "unclear"]
        },
        "cpc_affiliated": {"$ref": "#/$defs/tri_state"},
        "provides_abortions": {"$ref": "#/$defs/tri_state"},
        "site_loaded": {"type": "boolean"},
        "evidence_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "confidence": {"enum": ["high", "medium", "low"]}
      }
    }
  }
}
